# Sightline Safety Academy — web image (SPEC-012 / ADR-009)
# Stage 1: build the Vite SPA. Stage 2: serve it with nginx, proxying /api.
# Build context is the repo root: docker compose -f ops/docker-compose.yml uses context "..".

FROM node:22 AS build

WORKDIR /app/web

COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ ./
RUN npm run build

FROM nginx:alpine

COPY ops/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /app/web/dist/ /usr/share/nginx/html/

EXPOSE 80
