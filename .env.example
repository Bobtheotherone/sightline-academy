# Sightline ATV Safety Academy — configuration template.
#
# Copy to .env for LOCAL DEVELOPMENT ONLY:  cp .env.example .env
#
# In production none of this belongs in a file on disk. Every value below is
# read from the process environment, which is what a managed host's secret
# store injects (Fly secrets, Render environment groups, a VPS systemd
# EnvironmentFile with 0600 permissions). .env is gitignored and has never
# been committed — keep it that way.

# ── Environment ──────────────────────────────────────────────────────────────
# 'development' or 'production'. Production runs a startup safety check and
# REFUSES TO BOOT if any of the settings below are unsafe. That is deliberate:
# a site that comes up looking healthy while being insecure is worse than one
# that does not come up.
APP_ENV=development

# Public origin of the deployed site. Stripe redirects back here after
# checkout, and the cross-origin request check compares against it.
# Must be https:// in production.
PUBLIC_BASE_URL=http://localhost:8080

# ── Sessions / auth ──────────────────────────────────────────────────────────
# Generate a fresh one per environment:  python -c "import secrets; print(secrets.token_hex(32))"
# Anyone holding this can mint session cookies for any account.
SESSION_SECRET=change-me-to-64-random-hex-chars

# 1 => the session cookie is only sent over HTTPS. Must be 1 in production.
SECURE_COOKIES=0

# How many reverse proxies YOU operate in front of the app. The real client IP
# is found by counting this many hops from the RIGHT of X-Forwarded-For;
# everything further left is caller-supplied and ignored. 1 matches the bundled
# nginx. Use 2 if you add a CDN, 0 if uvicorn is exposed directly.
# Setting this too HIGH re-opens rate-limit bypass — change it only with the topology.
TRUSTED_PROXY_HOPS=1

# ── Roles (SPEC-011) ─────────────────────────────────────────────────────────
# Role is assigned when one of these addresses registers. Afterwards, roles are
# changed through the admin API by someone permitted to grant that role.
#
# OWNER_EMAIL is Osama's address: exactly one, the responsible faculty member.
# It is the ONLY account ever granted funds access, and the only account that
# can grant funds access or create instructor/admin accounts.
OWNER_EMAIL=

# Full operational admins (Rad and any other maintainer). They can create
# learner and developer accounts. They can NEVER see or grant funds access,
# and cannot mint faculty accounts.
ADMIN_EMAILS=

# UAA faculty teaching the course: free access + the instructor dashboard.
INSTRUCTOR_EMAILS=

# Student-worker contributors: free access, no learner data, no admin.
DEVELOPER_EMAILS=

# ── Billing (SPEC-012) ───────────────────────────────────────────────────────
# IMPORTANT: the Stripe ACCOUNT these keys belong to is what receives the money.
# Keeping that account and these keys under Osama's sole control is what makes
# "only Osama has access to the funds" true at the money layer; the
# can_access_funds flag enforces it inside the application.
#
# Leave blank for local development: with billing unconfigured the paywall is
# automatically DISABLED rather than locking everyone out.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` locally, or the webhook endpoint's signing secret in the
# Stripe dashboard. Without it, webhooks are rejected and nobody gains access.
STRIPE_WEBHOOK_SECRET=

# Recurring Price IDs created in the Stripe dashboard (price_..., not prod_...).
# Standard = $10/month. Launch = $5/month.
STRIPE_PRICE_ID_STANDARD=
STRIPE_PRICE_ID_LAUNCH=

# 1 => new subscribers get the launch price. Flip to 0 to end the sale; people
# already subscribed keep the price they signed up at (that is Stripe's own
# behaviour, not something this app decides).
LAUNCH_SALE_ACTIVE=1

# Display only — Stripe's Price object is the authority on what is charged.
# These exist so the pricing page never hardcodes a number that can drift.
PRICE_STANDARD_CENTS=1000
PRICE_LAUNCH_CENTS=500

# 1 => course content requires an active subscription. Staff always read free.
REQUIRE_SUBSCRIPTION=1

# ── Tutor (Ranger) ───────────────────────────────────────────────────────────
# Empty => Ranger answers from the course corpus only ("extractive" mode).
# That is a supported mode, but it is now reported loudly at startup and on
# /api/meta/health instead of degrading silently.
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-sonnet-4-6

# Per-learner tutor caps. The key is personal and metered, so an uncapped
# endpoint is a spend risk, not just a load one. 0 disables a cap.
TUTOR_MESSAGES_PER_HOUR=30
TUTOR_MESSAGES_PER_DAY=150

# ── Storage ──────────────────────────────────────────────────────────────────
# THE most important production setting. Leave blank and the app uses a SQLite
# file on local disk — which is exactly how a site dies when the machine it
# lives on is turned off. Set it to a managed Postgres URL and the data outlives
# the container, survives restarts, and is backed up by the provider.
# `postgres://` URLs are normalised automatically.
DATABASE_URL=

DATA_DIR=../data
CONTENT_DIR=../content

# ── Boot behaviour ───────────────────────────────────────────────────────────
SEED_FORCE=0
# 1 => create QA fixture accounts with known passwords. NEVER in production;
# the startup check refuses to boot if this is on.
FIXTURES=0
